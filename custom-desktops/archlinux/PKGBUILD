# then please put 'unknown'.

# Maintainer: Your Name <youremail@domain.com>
pkgname=custom-desktops
pkgver=1
pkgrel=1
epoch=
pkgdesc="Hides some ugly .desktop files"
arch=('any')
url=""
license=('WTFPL')
groups=()
depends=()
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=()
noextract=()
sha256sums=()
validpgpkeys=()

package() {	
        mkdir -p $pkgdir/usr/local/share/applications
	cp $srcdir/* $pkgdir/usr/local/share/applications
}

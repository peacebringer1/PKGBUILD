# then please put 'unknown'.

# Maintainer: Your Name <youremail@domain.com>
pkgname=custom-skel
pkgver=1
pkgrel=1
epoch=
pkgdesc=""
arch=('any')
url=""
license=('WTFPL')
groups=()
depends=()
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=()
noextract=()
sha256sums=()
validpgpkeys=()

package() {
	cd $srcdir
	
        mkdir -p $pkgdir/etc/skel/
        
        cp -r $srcdir/.local $pkgdir/etc/skel/
}

# NOTE: Please fill out the license field for your package! If it is unknown,
# then please put 'unknown'.

# Maintainer: Your Name <youremail@domain.com>
pkgname=custom-wallpapers
pkgver=1
pkgrel=2
epoch=
pkgdesc=""
arch=('any')
url=""
license=('WTFPL')
groups=()
depends=()
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=()
noextract=()
sha256sums=()
validpgpkeys=()

package() {
	cd $srcdir

        mkdir -p $pkgdir/usr/share/backgrounds/custom-wallpapers
        mkdir -p $pkgdir/usr/share/gnome-background-properties
        
        cp $srcdir/henrieke-fischer-GCdigLv0h_U-unsplash.jpg $pkgdir/usr/share/backgrounds/custom-wallpapers/
        cp $srcdir/carlos-torres-MHNjEBeLTgw-unsplash.jpg $pkgdir/usr/share/backgrounds/custom-wallpapers/
        cp $srcdir/clouds.xml $pkgdir/usr/share/gnome-background-properties/
}

pkgname=ttf-syzpori-hinted
pkgver=1.0.2
pkgrel=1
epoch=
pkgdesc="Syzpori fonts (hinted)"
arch=('any')
url="https://github.com/peacebringer1/syzpori/"
license=('OFL-1.1-RFN')
groups=()
depends=()
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=("${url}/releases/download/v${pkgver}/Syzpori.zip")
noextract=()
sha256sums=("2e8f334afe04fd84b044375693267e42e30891ec06a650ab4a3e5a0ef7ab1f4b")
validpgpkeys=()

package(){
      mkdir -p $pkgdir/usr/local/share/fonts/Syzpori/
      cp $srcdir/*.ttf $pkgdir/usr/local/share/fonts/Syzpori/  
}